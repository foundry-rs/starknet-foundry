#[test]
fn returning_fn__snforge_internal_fuzzer_generated() {
    if snforge_std::_internals::is_config_run() {
        returning_fn__snforge_internal_config();
        return;
    }
    let a = snforge_std::fuzzable::Fuzzable::<u8>::generate();
    snforge_std::_internals::save_fuzzer_arg(@a);
    let _ = returning_fn(a);
}
#[__snforge_extract_config]
fn returning_fn(a: u8) -> Result<NonZero<u8>, u8> {
    if snforge_std::_internals::is_config_run() {
        let mut data = array![];
        snforge_std::_internals::config_types::AvailableResourceBoundsConfig {
            l1_gas: 0xffffffffffffffff, l1_data_gas: 0xffffffffffffffff, l2_gas: 0x3e7,
        }
            .serialize(ref data);
        starknet::testing::cheatcode::<'set_config_available_gas'>(data.span());
        return Default::default();
    }
    Result::Ok(a)
}
