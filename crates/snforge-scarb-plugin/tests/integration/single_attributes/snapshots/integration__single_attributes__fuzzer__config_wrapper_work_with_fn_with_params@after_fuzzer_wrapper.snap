    snforge_std::_internals::save_fuzzer_arg(@f);
    let u = snforge_std::fuzzable::Fuzzable::<u32>::generate();
    snforge_std::_internals::save_fuzzer_arg(@u);
    let _ = empty_fn(f, u);
}
